{
	"name": "directus-extension-storage-manager",
	"description": "Browse, upload, detect, materialize, move Directus files across storages, and find unreferenced File Library entries",
	"icon": "storage",
	"version": "1.4.0",
	"license": "MIT",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle",
		"storage",
		"storage-manager",
		"migration",
		"files",
		"s3",
		"gcs",
		"azure",
		"move",
		"copy",
		"orphans",
		"unreferenced",
		"lifecycle"
	],
	"type": "module",
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/domdus/directus-extension-storage-manager.git"
	},
	"bugs": {
		"url": "https://github.com/domdus/directus-extension-storage-manager/issues"
	},
	"homepage": "https://github.com/domdus/directus-extension-storage-manager#readme",
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "module",
				"name": "storage-manager-module",
				"source": "src/module/index.ts"
			},
			{
				"type": "endpoint",
				"name": "storage-manager-endpoint",
				"source": "src/endpoint/index.ts"
			},
			{
				"type": "operation",
				"name": "storage-manager-operation",
				"source": {
					"app": "src/operation/app.ts",
					"api": "src/operation/api.ts"
				}
			},
			{
				"type": "hook",
				"name": "storage-manager-hook",
				"source": "src/hook/index.ts"
			},
			{
				"type": "interface",
				"name": "storage-manager-file-with-storage",
				"source": "src/interfaces/file-with-storage/index.ts"
			},
			{
				"type": "interface",
				"name": "storage-manager-image-with-storage",
				"source": "src/interfaces/image-with-storage/index.ts"
			},
			{
				"type": "interface",
				"name": "storage-manager-files-with-storage",
				"source": "src/interfaces/files-with-storage/index.ts"
			},
			{
				"type": "interface",
				"name": "storage-manager-storage-location",
				"source": "src/interfaces/storage-location-option/index.ts"
			}
		],
		"host": ">=9.26.0 <13.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "^17.0.0",
		"@types/express": "^4.17.21",
		"@types/node": "^20.0.0",
		"lodash-es": "^4.17.21",
		"micromustache": "^8.0.3",
		"typescript": "^5.0.0",
		"vue": "^3.3.7",
		"vuedraggable": "^4.1.0"
	}
}
